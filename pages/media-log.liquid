---
layout: layout.html
title: media log
eleventyNavigation:
  key: media log
---

{% assign media = collections.media | group_by_exp: "item", "item.page.date | date: '%B'" | reverse %}

<ol>
{% for month in media %}
  {{ month.name }}

  <ol>
  {% for medium in month.items %}
    <li>
      {{ medium.data.name }} ({{ medium.data.type }}) {% if medium.data.creator %}- {{ medium.data.creator }}{% endif %}
    </li>
  {% endfor %}
  </ol>
{% endfor %}

</ol>

